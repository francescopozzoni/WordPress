{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sanfilipponeri/slider",
	"title": "Slider a schede",
	"category": "design",
	"icon": "slides",
	"description": "Slider della homepage: ogni scheda ha un titolo nel riquadro blu, un link nella barra di navigazione e un contenuto libero sotto.",
	"keywords": [ "slider", "home", "schede", "oratorio" ],
	"textdomain": "sanfilipponeri",
	"supports": {
		"html": false,
		"multiple": false,
		"align": [ "full" ]
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
